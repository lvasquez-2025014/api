{
  "name": "keyauth-integrated",
  "version": "1.0.0",
  "description": "Proyecto integrado de Backend (Node.js/TypeScript) y Frontend (React/TailwindCSS) para KeyAuth Clone.",
  "main": "backend/dist/server.js",
  "scripts": {
    "install-all": "pnpm install --filter=./backend && pnpm install --filter=./frontend",
    "build-backend": "pnpm --filter=./backend build",
    "build-frontend": "pnpm --filter=./frontend build",
    "build": "pnpm build-backend && pnpm build-frontend",
    "start-backend": "pnpm --filter=./backend start",
    "start-frontend": "pnpm --filter=./frontend dev",
    "dev": "pnpm start-backend & pnpm start-frontend",
    "start": "pnpm build && pnpm start-backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@8.15.6"
}
